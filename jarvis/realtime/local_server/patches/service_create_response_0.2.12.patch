     # ── STT → LM bridge ────────────────────────────
 
+    def _client_wants_auto_response(self, cfg) -> bool:
+        """Whether the session's turn_detection asks for automatic responses.
+
+        LOCAL PATCH (pending upstream, speech-to-speech 0.2.12): the OpenAI
+        Realtime protocol's manual-response mode (``turn_detection.
+        create_response: false``) was ignored — every final transcription
+        triggered a full LLM generation plus TTS that a manual-mode client
+        then had to cancel as unsolicited. That doubled LLM load and burned
+        seconds of TTS per turn for nothing. Default stays True: only an
+        explicit ``create_response: false`` disables the auto response.
+        """
+        session = getattr(cfg, "session", None)
+        audio = getattr(session, "audio", None)
+        audio_input = getattr(audio, "input", None)
+        turn_detection = getattr(audio_input, "turn_detection", None)
+        create_response = getattr(turn_detection, "create_response", None)
+        return True if create_response is None else bool(create_response)
+
