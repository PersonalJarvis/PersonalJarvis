{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "azure",
  "version": "1.0.0",
  "description": "List subscriptions and resources; query actual Azure costs",
  "license": "Apache-2.0",
  "extensions": {
    "io.github.personaljarvis": {
      "display_name": "Microsoft Azure",
      "category": "Developer",
      "logo_slug": "azure",
      "logo_color": "0089D6",
      "featured": false,
      "longevity": "self_renewing",
      "auth": {
        "mode": "oauth_pkce_loopback",
        "authorization_url": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
        "token_url": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
        "client_id": "3d9a5802-a0c2-4fd8-84b5-8d33c540aea4",
        "callback_port": 43891,
        "callback_path": "/oauth/callback",
        "scopes": [
          "offline_access",
          "https://management.azure.com/user_impersonation"
        ],
        "scope_separator": "space",
        "refresh_supported": true,
        "redirect_host": "localhost"
      },
      "mcp_server": {
        "transport": "stdio",
        "install": [
          "python",
          "-m",
          "jarvis.plugins.tool.connected_server",
          "azure"
        ],
        "env_template": {
          "JARVIS_CONNECTOR_TOKEN": "$plugin_azure_access_token"
        },
        "risk_tier": "ask"
      },
      "post_install_hint_md": "Connect opens the official provider sign-in. Approve the requested permissions and return to Personal Jarvis. Organizational policy may require administrator approval.",
      "oauth_client_family": "microsoft",
      "publisher_managed": true,
      "browser_flow": "publisher_pkce"
    }
  }
}
