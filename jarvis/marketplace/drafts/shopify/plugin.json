{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "shopify",
  "version": "1.0.0",
  "description": "Products, orders, customers and discounts through the official Shopify MCP server",
  "license": "Apache-2.0",
  "extensions": {
    "io.github.personaljarvis": {
      "display_name": "Shopify",
      "category": "Knowledge & Reading",
      "logo_slug": "shopify",
      "logo_color": "95BF47",
      "featured": false,
      "longevity": "self_renewing",
      "oauth_client_family": "shopify",
      "auth": {
        "mode": "oauth_pkce_loopback",
        "authorization_url": "https://setup.shopify.com/oauth/authorize",
        "token_url": "https://setup.shopify.com/oauth/token",
        "client_id": "REPLACE_WITH_JARVIS_SHOPIFY_CLIENT_ID",
        "callback_port": 3130,
        "callback_path": "/oauth/callback",
        "scopes": [
          "read_products",
          "read_orders",
          "read_customers",
          "read_discounts"
        ],
        "scope_separator": "comma",
        "refresh_supported": true,
        "resource": "https://setup.shopify.com/mcp"
      },
      "mcp_server": {
        "transport": "http",
        "url": "https://setup.shopify.com/mcp",
        "auth_header_template": "Authorization: Bearer $plugin_shopify_access_token",
        "risk_tier": "ask"
      },
      "post_install_hint_md": "Connect signs you in at Shopify in the browser with read access to products, orders, customers and discounts. If the shared sign-in is not provisioned yet, register your own Shopify app and enter its client ID through the dialog's expert option instead."
    }
  }
}
