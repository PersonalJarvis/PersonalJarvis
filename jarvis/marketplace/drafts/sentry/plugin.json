{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sentry",
  "version": "1.0.0",
  "description": "Errors, issues and releases from your Sentry projects",
  "license": "Apache-2.0",
  "extensions": {
    "io.github.personaljarvis": {
      "display_name": "Sentry",
      "category": "Developer",
      "logo_slug": "sentry",
      "logo_color": "362D59",
      "featured": false,
      "longevity": "self_renewing",
      "browser_flow": "dcr",
      "auth": {
        "mode": "hosted_mcp_oauth_dcr",
        "mcp_url": "https://mcp.sentry.dev/mcp",
        "discovery_url": "https://mcp.sentry.dev/.well-known/oauth-protected-resource/mcp",
        "refresh_supported": true
      },
      "mcp_server": {
        "transport": "http",
        "url": "https://mcp.sentry.dev/mcp",
        "auth_header_template": "Authorization: Bearer ${plugin_sentry_access_token}"
      },
      "post_install_hint_md": "Sign in with your Sentry account and approve the organization to connect. Self-hosted Sentry is not included."
    }
  }
}
