{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "intercom",
  "version": "1.0.0",
  "description": "Customer conversations, contacts and help articles",
  "license": "Apache-2.0",
  "extensions": {
    "io.github.personaljarvis": {
      "display_name": "Intercom",
      "category": "Messaging",
      "logo_slug": "intercom",
      "logo_color": "1F8DED",
      "featured": false,
      "longevity": "self_renewing",
      "browser_flow": "dcr",
      "auth": {
        "mode": "hosted_mcp_oauth_dcr",
        "mcp_url": "https://mcp.intercom.com/mcp",
        "discovery_url": "https://mcp.intercom.com/.well-known/oauth-protected-resource/mcp",
        "refresh_supported": true
      },
      "mcp_server": {
        "transport": "http",
        "url": "https://mcp.intercom.com/mcp",
        "auth_header_template": "Authorization: Bearer ${plugin_intercom_access_token}",
        "risk_tier": "ask"
      },
      "post_install_hint_md": "Sign in with an Intercom teammate account. Workspaces in the EU or Australia region may need their own regional connector."
    }
  }
}
