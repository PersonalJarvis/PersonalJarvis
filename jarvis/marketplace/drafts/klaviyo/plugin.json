{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "klaviyo",
  "version": "1.0.0",
  "description": "Email and SMS campaigns, flows, lists and metrics",
  "license": "Apache-2.0",
  "extensions": {
    "io.github.personaljarvis": {
      "display_name": "Klaviyo",
      "category": "Calendar & Mail",
      "logo_slug": "klaviyo",
      "logo_color": "232426",
      "featured": false,
      "longevity": "self_renewing",
      "browser_flow": "dcr",
      "auth": {
        "mode": "hosted_mcp_oauth_dcr",
        "mcp_url": "https://mcp.klaviyo.com/mcp",
        "discovery_url": "https://mcp.klaviyo.com/.well-known/oauth-protected-resource/mcp",
        "refresh_supported": true
      },
      "mcp_server": {
        "transport": "http",
        "url": "https://mcp.klaviyo.com/mcp",
        "auth_header_template": "Authorization: Bearer ${plugin_klaviyo_access_token}",
        "risk_tier": "ask"
      },
      "post_install_hint_md": "Sign in with your Klaviyo account. Creating or sending campaigns asks for approval first."
    }
  }
}
