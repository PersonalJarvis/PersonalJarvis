{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ramp",
  "version": "1.0.0",
  "description": "Spend, cards, bills and reimbursements",
  "license": "Apache-2.0",
  "extensions": {
    "io.github.personaljarvis": {
      "display_name": "Ramp",
      "category": "Knowledge & Reading",
      "logo_slug": "ramp",
      "logo_color": "1A1A1A",
      "featured": false,
      "longevity": "self_renewing",
      "browser_flow": "dcr",
      "auth": {
        "mode": "hosted_mcp_oauth_dcr",
        "mcp_url": "https://mcp.ramp.com/mcp",
        "discovery_url": "https://mcp.ramp.com/.well-known/oauth-protected-resource/mcp",
        "refresh_supported": true
      },
      "mcp_server": {
        "transport": "http",
        "url": "https://mcp.ramp.com/mcp",
        "auth_header_template": "Authorization: Bearer ${plugin_ramp_access_token}",
        "risk_tier": "ask"
      },
      "post_install_hint_md": "Sign in with a Ramp business account. Data follows your Ramp role."
    }
  }
}
