{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "neon",
  "version": "1.0.0",
  "description": "Serverless Postgres projects, branches and queries",
  "license": "Apache-2.0",
  "extensions": {
    "io.github.personaljarvis": {
      "display_name": "Neon",
      "category": "Developer",
      "logo_slug": "neon",
      "logo_color": "00E599",
      "featured": false,
      "longevity": "self_renewing",
      "browser_flow": "dcr",
      "auth": {
        "mode": "hosted_mcp_oauth_dcr",
        "mcp_url": "https://mcp.neon.tech/mcp",
        "discovery_url": "https://mcp.neon.tech/.well-known/oauth-protected-resource/mcp",
        "refresh_supported": true
      },
      "mcp_server": {
        "transport": "http",
        "url": "https://mcp.neon.tech/mcp",
        "auth_header_template": "Authorization: Bearer ${plugin_neon_access_token}",
        "risk_tier": "ask"
      },
      "post_install_hint_md": "Sign in with your Neon account. Schema changes and SQL that writes data ask for approval first."
    }
  }
}
