{
  "name": "split_reply_pause",
  "description": "A prompt that invites a longer, pause-bearing answer: generation pauses beyond the 1.2s backstop must not produce audible seams or splices (Fix E's live guard).",
  "steps": [
    {
      "silence_s": 1.0
    },
    {
      "speak": "en_zebrastorm"
    },
    {
      "wait_reply": {
        "timeout_s": 25
      }
    },
    {
      "silence_s": 0.75
    },
    {
      "speak": "de_fahrrad"
    },
    {
      "wait_reply": {
        "timeout_s": 25
      }
    },
    {
      "end": {}
    }
  ],
  "asserts": [
    "turns>=2",
    "no_ungrounded",
    "no_roleplay",
    "audio_continuity",
    "no_rebuilds",
    "clean_close"
  ]
}
